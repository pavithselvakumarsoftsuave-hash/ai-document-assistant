LLM_PROVIDER=huggingface
HF_API_KEY=replace-with-your-huggingface-token
HF_MODEL=Qwen/Qwen3.5-9B:fastest
HF_HOME=./.model-cache
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
DATABASE_URL=sqlite:///./data/assistant.db
DATA_DIR=./data
MAX_UPLOAD_SIZE_MB=25
CHUNK_SIZE=1000
CHUNK_OVERLAP=150
RETRIEVAL_K=3
RETRIEVAL_MIN_RELEVANCE_SCORE=0.2
LLM_TIMEOUT_SECONDS=45
LLM_MAX_TOKENS=400
